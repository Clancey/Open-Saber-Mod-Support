[layer_names]

3d_render/layer_1="VR"
3d_render/layer_2="Desktop"
3d_physics/layer_1="Obstacles"
3d_physics/layer_2="UI"
3d_physics/layer_3="Player"
3d_physics/layer_4="Floor"
3d_physics/layer_5="Saber"
3d_physics/layer_6="Bombs"
3d_physics/layer_10="LeftNote"
3d_physics/layer_11="RightNote"

[physics]

common/physics_jitter_fix=0.0
common/physics_ticks_per_second=72
3d/physics_engine="Jolt Physics"

[rendering]

renderer/rendering_method="mobile"
rendering_device/driver.visionos="metal"
textures/vram_compression/import_etc2_astc=true
shading/overrides/force_lambert_over_burley=true
environment/defaults/default_clear_color=Color(0, 0, 0, 1)
environment/defaults/default_environment="res://default_env.tres"
shading/overrides/force_vertex_shading.mobile=false
lights_and_shadows/directional_shadow/size=256
lights_and_shadows/positional_shadow/atlas_size=256
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=0
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=0
reflections/sky_reflections/texture_array_reflections=false
reflections/sky_reflections/fast_filter_high_quality=false
shading/overrides/force_blinn_over_ggx.mobile=false
environment/glow/upscale_mode.mobile=0
anti_aliasing/quality/msaa_3d=2

[shader_globals]

left_saber={
"type": "vec3",
"value": Vector3(-0.5, 0, 0)
}
right_saber={
"type": "vec3",
"value": Vector3(0.5, 0, 0)
}

[xr]

openxr/enabled=true
openxr/enabled.visionos=false
shaders/enabled=true
openxr/extensions/hand_tracking=false
openxr/reference_space=2
openxr/startup_alert=false
openxr/foveation_level=3
openxr/foveation_dynamic=true
openxr/submit_depth_buffer=false
visionos/enable_controller_tracking=true
visionos/enable_hand_tracking=true
